<!--
  Only pages that are complete and meant to be indexed belong here.

  URLs use the www host because the apex 308-redirects to it; a sitemap should
  list the address that actually serves each page.

  The legal pages — /privacy, /privacy/de, /terms, /terms/de and /impressum —
  are deliberately absent. Each carries <meta name="robots" content="noindex">,
  so listing them here would ask search engines to index pages that then ask
  not to be indexed. They remain publicly reachable and crawlable at their own
  URLs; only the index entry is withheld, never access. Crawling is what lets
  the noindex directive be discovered, which is why robots.txt still allows it.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.getgutwell.app/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.getgutwell.app/support</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
